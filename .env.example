# Copy to .env and load explicitly: uv run --env-file .env <command>
# .env is ignored. Keep real credentials out of committed files.

# Standard credential and endpoint lookup for caller-created OpenAI SDK clients and
# declarative OpenAI slots whose api_key/base_url fields are omitted.
# Model selection and embedding dimensions belong in Memory.from_config() or injected backends.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Optional evaluation-runner overrides; these do not configure the product SDK or CLI.
# Explicit evaluation configuration and command-line flags take precedence.
# SENSEMEM_GENERATION_API_KEY=
# SENSEMEM_GENERATION_BASE_URL=https://api.openai.com/v1
# SENSEMEM_GENERATION_MODEL=gpt-5-mini-2025-08-07
# SENSEMEM_GENERATION_MODALITIES=text
# SENSEMEM_TIMEOUT_SECONDS=300

# An unset evaluation judge reuses the generation configuration.
# SENSEMEM_JUDGE_API_KEY=
# SENSEMEM_JUDGE_BASE_URL=https://judge.example/v1
# SENSEMEM_JUDGE_MODEL=your-pinned-judge-model
# SENSEMEM_JUDGE_TIMEOUT_SECONDS=300

# Dataset download settings for the evaluation runner.
# HF_HOME=/absolute/path/to/huggingface-cache
# HF_ENDPOINT=https://huggingface.co
# SENSEMEM_BENCH_YOUTUBE_SLEEP_SECONDS=30

# Inbound key for the participant-hosted AML benchmark adapter only.
# The product REST and MCP adapters rely on host-provided authentication.
# SENSEMEM_AML_API_KEY=
